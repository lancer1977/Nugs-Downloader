@page "/jobs/{JobId:guid}"
@implements IAsyncDisposable
@using NugsDownloader.App.Abstractions
@using NugsDownloader.App.UseCases
@using NugsDownloader.Domain.Entities
@using NugsDownloader.Web.Services
@inject IBackgroundDownloadQueue DownloadQueue
@inject IJobRepository JobRepository
@inject IFileStateRepository FileStateRepository

<h1>Job Details</h1>

@if (_job is null)
{
    <p>Job not found.</p>
}
else
{
    <p><strong>Provider:</strong> @_job.ProviderId</p>
    <p><strong>Source:</strong> @_job.SourceUrl</p>
    <p><strong>Status:</strong> @_job.Status</p>
    <p><strong>Retry attempts:</strong> @_job.RetryCount</p>
    <p><strong>Next retry:</strong> @(_job.NextAttemptAt?.ToLocalTime().ToString("g") ?? "not scheduled")</p>
    <p><strong>Worker lease:</strong> @(_job.LeaseOwnerId is null ? "not held" : $"held until {_job.LeaseExpiresAt?.ToLocalTime():g}")</p>
    <p><strong>Output:</strong> @_job.OutputPath</p>

    <h2>Discovery Result</h2>
    <p><strong>Title:</strong> @_job.DisplayName</p>
    <p><strong>Canonical Source:</strong> @_job.SourceUrl</p>
    <p><strong>Expected Files:</strong> @_fileStates.Count</p>
    <p><strong>Downloaded Bytes:</strong> @FormatBytes(_fileStates.Sum(state => state.ActualSize))</p>
    <p><strong>Audio:</strong> @_fileStates.Count(state => state.Kind == FileKind.Audio)</p>
    <p><strong>Video:</strong> @_fileStates.Count(state => state.Kind == FileKind.Video)</p>

    <div>
        <button type="button" @onclick="ResumeAsync">Resume</button>
        <button type="button" @onclick="RetryAsync">Retry</button>
        <button type="button" @onclick="CancelAsync">Cancel</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <p>@_message</p>
    }

    <h2>Files</h2>
    <ul>
        @foreach (var state in _fileStates)
        {
            <li>@state.FilePath - @state.Status - @state.Kind - @FormatBytes(state.ActualSize)</li>
        }
    </ul>
}

@code {
    [Parameter] public Guid JobId { get; set; }

    private DownloadJob? _job;
    private IReadOnlyList<FileState> _fileStates = Array.Empty<FileState>();
    private string? _message;
    private readonly CancellationTokenSource _refreshCancellation = new();
    private Task? _refreshTask;

    protected override async Task OnParametersSetAsync()
    {
        _job = await JobRepository.GetAsync(JobId, CancellationToken.None);
        if (_job is not null)
        {
            _fileStates = await FileStateRepository.GetByJobAsync(JobId, CancellationToken.None);
        }
        _refreshTask ??= RefreshJobAsync(_refreshCancellation.Token);
    }

    private async Task ResumeAsync()
    {
        var result = await DownloadQueue.ResumeAsync(JobId, CancellationToken.None);
        _message = $"{result.Status}: {result.Message}";
        await OnParametersSetAsync();
    }

    private async Task RetryAsync()
    {
        var result = await DownloadQueue.RetryAsync(JobId, CancellationToken.None);
        _message = $"{result.Status}: {result.Message}";
        await OnParametersSetAsync();
    }

    private async Task CancelAsync()
    {
        var result = await DownloadQueue.CancelAsync(JobId, CancellationToken.None);
        _message = $"{result.Status}: {result.Message}";
        await OnParametersSetAsync();
    }

    private async Task RefreshJobAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await InvokeAsync(async () =>
                {
                    await OnParametersSetAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        await _refreshCancellation.CancelAsync();
        if (_refreshTask is not null)
        {
            await _refreshTask;
        }
        _refreshCancellation.Dispose();
    }

    private static string FormatBytes(long value)
    {
        if (value < 1024)
        {
            return $"{value} B";
        }

        var units = new[] { "KB", "MB", "GB", "TB" };
        var size = value / 1024d;
        var unit = 0;
        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }

        return $"{size:0.##} {units[unit]}";
    }
}
