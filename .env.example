# Nugs-Downloader local environment
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:7060

# Web app storage paths.
NugsDownloader__StateDirectory=./state
NugsDownloader__DownloadDirectory=./downloads

# Optional live integration tests. Keep real values outside the repo.
NUGS_LIVE_TESTS=0
NUGS_USERNAME=
NUGS_PASSWORD=
NUGS_TOKEN=
NUGS_LIVE_DOWNLOAD_URL=
